# Normalize line endings to LF in the repository, on every OS.
* text=auto eol=lf

# Windows scripts keep CRLF so they run correctly in PowerShell and cmd.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.p12 binary

# Generated Dart code is collapsed in diffs and excluded from language stats.
*.g.dart linguist-generated=true
*.freezed.dart linguist-generated=true
lib/l10n/generated/** linguist-generated=true
